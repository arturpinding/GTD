<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calendarDayCardView"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="56dp"
    app:cardBackgroundColor="@color/gtd_surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/gtd_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/dayNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/gtd_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/entry1"
            style="@style/CalendarEntryPreview" />

        <TextView
            android:id="@+id/entry2"
            style="@style/CalendarEntryPreview" />

        <TextView
            android:id="@+id/entry3"
            style="@style/CalendarEntryPreview" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
