<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/data_and_cleanup"
            android:textColor="@color/gtd_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/gtd_text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/gtd_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/gtd_outline"
            app:strokeWidth="1dp">
            <TextView
                android:id="@+id/settingsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:padding="18dp"
                android:textColor="@color/gtd_text_primary"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/clearCompletedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/clear_completed" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearAllGtdButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/clear_all_gtd"
            android:textAllCaps="false"
            android:textColor="@color/gtd_danger"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="14dp"
            app:strokeColor="@color/gtd_danger"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_gtd_empty"
            android:text="@string/settings_preserve_note"
            android:textColor="@color/gtd_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
