<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GTD" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/gtd_primary</item>
        <item name="colorPrimaryVariant">@color/gtd_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gtd_accent</item>
        <item name="colorSecondaryVariant">@color/gtd_accent_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/gtd_surface</item>
        <item name="colorOnSurface">@color/gtd_text_primary</item>
        <item name="colorError">@color/gtd_danger</item>
        <item name="android:colorBackground">@color/gtd_background</item>
        <item name="android:textColorPrimary">@color/gtd_text_primary</item>
        <item name="android:textColorSecondary">@color/gtd_text_secondary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@color/gtd_primary_dark</item>
        <item name="android:navigationBarColor">@color/gtd_background</item>
        <item name="actionBarStyle">@style/Widget.GTD.ActionBar</item>
        <item name="materialButtonStyle">@style/Widget.GTD.Button</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.GTD.ActionBar" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="background">@color/gtd_primary</item>
        <item name="titleTextStyle">@style/TextAppearance.GTD.ActionBar.Title</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="TextAppearance.GTD.ActionBar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.GTD.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/gtd_accent</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="WeekdayLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/gtd_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalendarEntryPreview">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/gtd_text_secondary</item>
        <item name="android:textSize">9sp</item>
    </style>

    <style name="ReviewCheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/bg_gtd_input</item>
        <item name="android:buttonTint">@color/gtd_accent</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:textColor">@color/gtd_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
